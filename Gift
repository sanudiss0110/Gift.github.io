<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Happy Birthday SuduMahaththaya ❤️</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background:
                radial-gradient(circle at top, #4b1028, #16000b 55%, #050005);
            color: white;
            overflow-x: hidden;
        }

        .screen {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 25px;
        }

        .card {
            width: 100%;
            max-width: 700px;
        }

        .heart {
            font-size: 85px;
            animation: beat 1.2s infinite;
            filter: drop-shadow(0 0 25px #ff174f);
        }

        @keyframes beat {
            0%, 100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.18);
            }
        }

        .intro-title {
            font-size: 42px;
            margin: 25px 0 12px;
        }

        .intro-text {
            color: #ffcbdc;
            font-size: 18px;
            margin-bottom: 35px;
        }

        .gift-button {
            padding: 17px 38px;
            border: none;
            border-radius: 50px;
            background: linear-gradient(45deg, #ff174f, #ff5b91);
            color: white;
            font-size: 19px;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 0 35px rgba(255, 23, 79, .45);
            transition: .3s;
        }

        .gift-button:hover {
            transform: scale(1.08);
        }

        #birthdayScreen {
            display: none;
        }

        .birthday-title {
            font-size: 55px;
            color: #ff709b;
            text-shadow: 0 0 25px rgba(255, 80, 130, .6);
        }

        .name {
            font-size: 42px;
            margin-top: 12px;
            margin-bottom: 35px;
        }

        .message-card {
            background: rgba(255,255,255,.07);
            border: 1px solid rgba(255,255,255,.15);
            backdrop-filter: blur(12px);
            border-radius: 28px;
            padding: 35px 28px;
            line-height: 1.8;
            font-size: 18px;
            color: #ffe8ef;
            box-shadow: 0 20px 70px rgba(0,0,0,.45);
        }

        .message-card p {
            margin-bottom: 18px;
        }

        .highlight {
            color: #ff83aa;
            font-weight: bold;
        }

        .cake {
            font-size: 75px;
            margin: 35px 0 15px;
            animation: cakeFloat 2s ease-in-out infinite;
        }

        @keyframes cakeFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .final-text {
            font-size: 25px;
            color: #ffb2c9;
            margin-top: 25px;
        }

        .signature {
            margin-top: 35px;
            font-size: 16px;
            color: #dcaabb;
        }

        .heart-float {
            position: fixed;
            bottom: -40px;
            pointer-events: none;
            animation: floatHeart linear forwards;
            z-index: 20;
        }

        @keyframes floatHeart {
            from {
                transform: translateY(0) rotate(0);
                opacity: 1;
            }

            to {
                transform: translateY(-110vh) rotate(360deg);
                opacity: 0;
            }
        }

        .confetti {
            position: fixed;
            top: -20px;
            width: 9px;
            height: 16px;
            z-index: 30;
            animation: fall linear forwards;
        }

        @keyframes fall {
            from {
                transform: translateY(0) rotate(0);
            }

            to {
                transform: translateY(110vh) rotate(720deg);
            }
        }

        .firework {
            position: fixed;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            pointer-events: none;
            animation: explode 1.2s ease-out forwards;
            z-index: 25;
        }

        @keyframes explode {
            0% {
                box-shadow:
                    0 0 0 0 white;
                opacity: 1;
            }

            100% {
                box-shadow:
                    0 -100px 0 2px #ff4f81,
                    70px -70px 0 2px #ffd166,
                    100px 0 0 2px #ff7eb6,
                    70px 70px 0 2px #ffffff,
                    0 100px 0 2px #ff4f81,
                    -70px 70px 0 2px #ffd166,
                    -100px 0 0 2px #ff7eb6,
                    -70px -70px 0 2px #ffffff;
                opacity: 0;
            }
        }

        @media (max-width: 600px) {

            .intro-title {
                font-size: 32px;
            }

            .birthday-title {
                font-size: 40px;
            }

            .name {
                font-size: 32px;
            }

            .message-card {
                font-size: 16px;
                padding: 27px 20px;
            }
        }
    </style>
</head>

<body>

    <!-- OPENING -->
    <section class="screen" id="openingScreen">

        <div class="card">

            <div class="heart">❤️</div>

            <h1 class="intro-title">
                A Little Surprise For You
            </h1>

            <p class="intro-text">
                Something special is waiting for you...
            </p>

            <button class="gift-button" onclick="openGift()">
                🎁 Open Your Gift
            </button>

        </div>

    </section>


    <!-- BIRTHDAY -->
    <section class="screen" id="birthdayScreen">

        <div class="card">

            <div class="birthday-title">
                Happy Birthday 🎂
            </div>

            <div class="name">
                SuduMahaththaya ❤️
            </div>


            <div class="message-card">

                <p>
                    Today is a very special day because someone
                    very special was born. ❤️
                </p>

                <p>
                    I hope your birthday is filled with happiness,
                    beautiful memories, endless smiles and everything
                    your heart wishes for.
                </p>

                <p>
                    May every new day bring you more reasons to smile,
                    more dreams to chase and more beautiful moments
                    to remember.
                </p>

                <p>
                    Keep smiling, keep shining and always remember
                    how <span class="highlight">special you are.</span> ❤️
                </p>

                <p>
                    May all your wishes come true and may this new
                    year of your life be filled with love, happiness
                    and countless beautiful moments.
                </p>

                <p>
                    Wishing you the
                    <span class="highlight">
                        happiest birthday ever,
                        SuduMahaththaya!
                    </span>
                    🎂❤️
                </p>

            </div>


            <div class="cake">
                🎂
            </div>

            <div class="final-text">
                Make a wish... ✨
            </div>

            <div class="signature">
                A little birthday surprise made just for you ❤️
            </div>

        </div>

    </section>


    <script>

        function openGift() {

            document.getElementById("openingScreen").style.display = "none";

            document.getElementById("birthdayScreen").style.display = "flex";

            createConfetti();

            createFireworks();

            startHearts();

            window.scrollTo(0, 0);
        }


        function createConfetti() {

            for (let i = 0; i < 120; i++) {

                let piece = document.createElement("div");

                piece.className = "confetti";

                piece.style.left =
                    Math.random() * 100 + "vw";

                piece.style.animationDuration =
                    (2 + Math.random() * 3) + "s";

                piece.style.animationDelay =
                    Math.random() * 2 + "s";

                piece.style.background =
                    "hsl(" +
                    Math.random() * 360 +
                    ", 100%, 70%)";

                document.body.appendChild(piece);

                setTimeout(() => {
                    piece.remove();
                }, 6000);
            }
        }


        function createFireworks() {

            for (let i = 0; i < 12; i++) {

                setTimeout(() => {

                    let firework =
                        document.createElement("div");

                    firework.className = "firework";

                    firework.style.left =
                        (10 + Math.random() * 80) + "vw";

                    firework.style.top =
                        (10 + Math.random() * 55) + "vh";

                    document.body.appendChild(firework);

                    setTimeout(() => {
                        firework.remove();
                    }, 1300);

                }, i * 350);
            }
        }


        function startHearts() {

            setInterval(() => {

                let heart =
                    document.createElement("div");

                heart.className = "heart-float";

                heart.innerHTML =
                    ["❤️", "💕", "💗", "💖", "💘"]
                    [Math.floor(Math.random() * 5)];

                heart.style.left =
                    Math.random() * 100 + "vw";

                heart.style.fontSize =
                    (18 + Math.random() * 25) + "px";

                heart.style.animationDuration =
                    (4 + Math.random() * 4) + "s";

                document.body.appendChild(heart);

                setTimeout(() => {
                    heart.remove();
                }, 8000);

            }, 500);
        }

    </script>

</body>
</html>
